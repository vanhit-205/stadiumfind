<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- ===== AUTH FLOW ===== -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.stadiumfind.features.auth.presentation.login.LoginFragment"
        android:label="Đăng nhập"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:launchSingleTop="true"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.stadiumfind.features.auth.presentation.register.RegisterFragment"
        android:label="Đăng ký"
        tools:layout="@layout/fragment_register">

        <action
            android:id="@+id/action_registerFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:launchSingleTop="true"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out" />
    </fragment>

    <!-- ===== MAIN (Bottom Nav) FLOW ===== -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.stadiumfind.features.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_homeFragment_to_stadiumDetailFragment"
            app:destination="@id/stadiumDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.stadiumfind.features.search.SearchFragment"
        android:label="@string/nav_search"
        tools:layout="@layout/fragment_search">

        <action
            android:id="@+id/action_searchFragment_to_stadiumDetailFragment"
            app:destination="@id/stadiumDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/bookingFragment"
        android:name="com.example.stadiumfind.features.booking.BookingFragment"
        android:label="@string/nav_booking"
        tools:layout="@layout/fragment_booking">
        <argument
            android:name="stadiumId"
            app:argType="long"
            android:defaultValue="0L" />
        <argument
            android:name="stadiumName"
            app:argType="string"
            android:defaultValue="Sân bóng đá" />
        <argument
            android:name="pricePerHour"
            app:argType="float"
            android:defaultValue="200000.0f" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.stadiumfind.features.profile.ProfileFragment"
        android:label="@string/nav_profile"
        tools:layout="@layout/fragment_profile" />

    <!-- ===== STADIUM DETAIL FLOW ===== -->
    <fragment
        android:id="@+id/stadiumDetailFragment"
        android:name="com.example.stadiumfind.features.stadium.presentation.detail.StadiumDetailFragment"
        android:label="Chi tiết sân"
        tools:layout="@layout/fragment_stadium_detail">
        <argument
            android:name="stadiumId"
            app:argType="long"
            android:defaultValue="0L" />

        <action
            android:id="@+id/action_stadiumDetailFragment_to_bookingFragment"
            app:destination="@id/bookingFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <!-- Logout: quay về Login, xóa toàn bộ back stack -->
    <action
        android:id="@+id/action_global_loginFragment"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

</navigation>
