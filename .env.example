# Port chạy server backend
SERVER_PORT=8080

# Cấu hình kết nối MySQL Database
DB_URL=jdbc:mysql://localhost:3306/stadiumfind
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Cấu hình Hibernate (update, validate, create-drop)
JPA_DDL_AUTO=update
SHOW_SQL=true

# Khóa bí mật ký JWT Token (tối thiểu 256-bit Hex hoặc Base64 string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Thời gian sống của JWT Token (milliseconds)
JWT_ACCESS_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
